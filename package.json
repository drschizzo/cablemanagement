{
  "name": "cable-management",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Baie de brassage : jeu de cable management en 3D (three.js), moteur de câbles AVBD dans un Web Worker",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "bench": "vite-node tools/bench.ts",
    "precision": "vite-node tools/precision.ts",
    "levels": "vite-node tools/levels.ts",
    "solvable": "vite-node tools/solvable.ts",
    "showcase": "vite-node tools/showcase.ts",
    "free": "vite-node tools/free.ts",
    "pinch": "vite-node tools/pinch.ts",
    "release": "vite-node tools/release.ts",
    "fold": "vite-node tools/fold.ts",
    "route": "vite-node tools/route.ts",
    "plug": "vite-node tools/plug.ts",
    "plugin": "vite-node tools/plugin.ts",
    "bake": "vite-node tools/bake.ts"
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/three": "^0.183.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
